diff --git a/signaldesk/startup.py b/signaldesk/startup.py
new file mode 100644
index 0000000..525dbee
--- /dev/null
+++ b/signaldesk/startup.py
@@ -0,0 +1,45 @@
+"""Optional Windows launcher for the existing, shared Colibri installation."""
+from pathlib import Path
+import socket
+import subprocess
+import sys
+from urllib.parse import urlsplit
+
+from .config import ModelConfig
+
+
+def start_local_model(config: ModelConfig, launcher: Path | None = None) -> str:
+    """Launch only the known default 4B setup, never replace a listening server.
+
+    Colibri's existing script can stop a running model. Do not invoke it when
+    the port is occupied, even if that service is unhealthy or serves another
+    model. SignalDesk's normal health checks report readiness afterwards.
+    """
+    endpoint = urlsplit(config.base_url)
+    if (endpoint.scheme != 'http' or endpoint.hostname != '127.0.0.1'
+            or endpoint.port != 8000 or endpoint.path.rstrip('/') != '/v1'
+            or endpoint.username or endpoint.password or endpoint.query or endpoint.fragment
+            or config.model_id != ModelConfig().model_id):
+        return 'Automatic start skipped: custom model settings. Start your configured model server manually.'
+    try:
+        with socket.create_connection(('127.0.0.1', 8000), timeout=1):
+            return 'Port 8000 is already in use; leaving the existing server untouched.'
+    except ConnectionRefusedError:
+        pass
+    except OSError as exc:
+        return f'Automatic start skipped: could not safely check port 8000 ({exc}).'
+    if sys.platform != 'win32':
+        return 'Automatic Colibri start is supported on Windows. Start the model server manually.'
+    launcher = (launcher or Path(__file__).resolve().parents[2] / 'local-ai' / 'start-colibri.cmd').resolve()
+    if not launcher.is_file():
+        return f'Colibri launcher not found: {launcher}. Start it manually or pass --model-launcher PATH.'
+    # PowerShell literal quoting handles spaces and apostrophes without treating
+    # the path as executable PowerShell text. Keep Colibri in its own console.
+    command = "& '" + str(launcher).replace("'", "''") + "' '4b'"
+    try:
+        subprocess.Popen(['powershell.exe', '-NoProfile', '-Command', command],
+                         cwd=str(launcher.parent), creationflags=subprocess.CREATE_NEW_CONSOLE)
+    except OSError as exc:
+        return f'Could not start Colibri: {exc}. SignalDesk will still open.'
+    return ('Colibri start requested in a separate window. The model may show offline while it loads; '
+            'SignalDesk will detect it automatically. If it stays offline, check that window for errors.')
diff --git a/tests/test_startup.py b/tests/test_startup.py
new file mode 100644
index 0000000..99783dd
--- /dev/null
+++ b/tests/test_startup.py
@@ -0,0 +1,61 @@
+from unittest.mock import MagicMock
+
+import pytest
+from signaldesk.config import ModelConfig
+from signaldesk.startup import start_local_model
+
+
+@pytest.fixture
+def launch_env(monkeypatch, tmp_path):
+    from signaldesk import startup
+    launcher = tmp_path / "folder with spaces" / "start-colibri.cmd"
+    launcher.parent.mkdir()
+    launcher.write_text('@echo off')
+    connect, popen = MagicMock(side_effect=ConnectionRefusedError), MagicMock()
+    monkeypatch.setattr(startup.socket, 'create_connection', connect)
+    monkeypatch.setattr(startup.subprocess, 'Popen', popen)
+    monkeypatch.setattr(startup.subprocess, 'CREATE_NEW_CONSOLE', 16, raising=False)
+    monkeypatch.setattr(startup.sys, 'platform', 'win32')
+    return launcher, connect, popen
+
+
+def test_launches_existing_4b_script(launch_env):
+    launcher, _, popen = launch_env
+    assert 'start requested' in start_local_model(ModelConfig(), launcher)
+    assert popen.call_args.args[0][-1] == f"& '{launcher}' '4b'"
+    assert popen.call_args.kwargs['cwd'] == str(launcher.parent)
+
+
+def test_existing_listener_never_restarted(launch_env):
+    launcher, connect, popen = launch_env
+    connect.side_effect = None
+    assert 'untouched' in start_local_model(ModelConfig(), launcher)
+    popen.assert_not_called()
+
+
+@pytest.mark.parametrize('config', [ModelConfig(model_id='other'), ModelConfig(base_url='http://example.com:8000/v1')])
+def test_custom_model_never_replaced(launch_env, config):
+    launcher, connect, popen = launch_env
+    assert 'custom model' in start_local_model(config, launcher)
+    connect.assert_not_called()
+    popen.assert_not_called()
+
+
+def test_missing_launcher_does_not_prevent_app_start(launch_env):
+    launcher, _, popen = launch_env
+    launcher.unlink()
+    assert 'not found' in start_local_model(ModelConfig(), launcher)
+    popen.assert_not_called()
+
+
+def test_launch_failure_is_explained(launch_env):
+    launcher, _, popen = launch_env
+    popen.side_effect = OSError('PowerShell unavailable')
+    assert 'will still open' in start_local_model(ModelConfig(), launcher)
+
+
+def test_uncertain_port_check_does_not_launch(launch_env):
+    launcher, connect, popen = launch_env
+    connect.side_effect = TimeoutError()
+    assert 'could not safely check' in start_local_model(ModelConfig(), launcher)
+    popen.assert_not_called()
