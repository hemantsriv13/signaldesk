# Server-only values. Copy to D:\LocalAI\signaldesk\delivery.env; never commit filled values.
SIGNALDESK_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SIGNALDESK_SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
SIGNALDESK_OWNER_ID=REPLACE_WITH_YOUR_AUTH_USER_UUID
SIGNALDESK_READER_URL=https://YOUR_READER_DOMAIN/

# Enable only after the approved template, recipient opt-in and billing are ready.
SIGNALDESK_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_SENDER_PHONE_ID
WHATSAPP_TO=REPLACE_WITH_RECIPIENT_COUNTRY_CODE_AND_NUMBER
WHATSAPP_GRAPH_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_VERSION
WHATSAPP_TEMPLATE=signaldesk_daily_briefing
WHATSAPP_LANGUAGE=en
