# Copy to D:\LocalAI\signaldesk\delivery.env; never commit filled values.
SIGNALDESK_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret. Stays on this laptop; never goes into the app.
SIGNALDESK_SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
# Public key. Safe for the app; privacy comes from login and row-level security.
SIGNALDESK_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_KEY
SIGNALDESK_OWNER_ID=REPLACE_WITH_YOUR_AUTH_USER_UUID
